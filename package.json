{
  "name": "szvideo",
  "version": "1.0.0",
  "description": "Editor de vídeo con capa protectora de autoría, parche NoBlur para TikTok y preset legal compatible con TikTok Studio",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "dev": "npx serve .",
    "start": "electron .",
    "web": "npx serve .",
    "icon": "node scripts/make-icon.mjs",
    "build:web": "node scripts/build-web.mjs",
    "dist": "electron-builder --win"
  },
  "keywords": [
    "video",
    "editor",
    "ffmpeg",
    "autoría",
    "tiktok",
    "tiktok-studio",
    "noblur",
    "mp4",
    "electron"
  ],
  "author": "SzVideo",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/TU-USUARIO/SzVideo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TU-USUARIO/SzVideo.git"
  },
  "bugs": {
    "url": "https://github.com/TU-USUARIO/SzVideo/issues"
  },
  "dependencies": {},
  "devDependencies": {
    "@ffmpeg/ffmpeg": "^0.12.9",
    "@ffmpeg/util": "^0.12.1",
    "electron": "^38.2.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.szvideo.app",
    "productName": "SzVideo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "public/**",
      "src/**",
      "package.json",
      "!test/**",
      "!scripts/**",
      "!dist/**",
      "!app_backup.js",
      "!write_files.ps1",
      "!*.md"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SzVideo"
    },
    "portable": {
      "artifactName": "SzVideo-portable.exe"
    }
  }
}
